{
  "name": "@caffeinecatkr/blurssism",
  "version": "1.4.1",
  "description": "글래스모피즘과 블러 효과를 조합한 웹·앱 공용 디자인 시스템 · A web & app design system combining glassmorphism and blur — Blurema crema, caffeine palettes, brand-color palettes, responsive grid, React & Svelte components",
  "author": {
    "name": "caffeinecat",
    "email": "leeunchan10@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://leeuc10.github.io/blurssism/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leeuc10/blurssism.git"
  },
  "bugs": {
    "url": "https://github.com/leeuc10/blurssism/issues",
    "email": "leeunchan10@gmail.com"
  },
  "keywords": [
    "backdrop-filter",
    "blur",
    "brand-color",
    "coffee",
    "components",
    "crema",
    "css",
    "dark-mode",
    "design-system",
    "design-tokens",
    "esm",
    "glassmorphism",
    "korean",
    "liquid-glass",
    "nextjs",
    "palette",
    "react",
    "responsive",
    "ssr",
    "svelte",
    "sveltekit",
    "theming",
    "ui"
  ],
  "bin": {
    "blurssism": "bin/blurssism.mjs"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "unpkg": "dist/bundle.js",
  "jsdelivr": "dist/bundle.js",
  "style": "dist/bundle.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./global": "./dist/bundle.js",
    "./bundle.js": "./dist/bundle.js",
    "./tokens.css": "./dist/tokens.css",
    "./bundle.css": "./dist/bundle.css",
    "./styles.css": "./dist/bundle.css",
    "./tokens.json": "./dist/tokens.json",
    "./tailwind": "./dist/tailwind-preset.js",
    "./logos/*": "./logos/*",
    "./package.json": "./package.json",
    "./svelte": {
      "types": "./svelte/index.d.ts",
      "svelte": "./svelte/index.js",
      "default": "./svelte/index.js"
    },
    "./utils": {
      "types": "./svelte/utils.d.ts",
      "default": "./dist/utils.mjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "svelte",
    "src/core.js",
    "src/utils.js",
    "src/tokens.json",
    "src/bundle.css",
    "logos",
    "docs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css",
    "./dist/bundle.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && svelte-package -i src/svelte -o svelte",
    "check": "node scripts/check.mjs && svelte-check --tsconfig ./tsconfig.json",
    "prepublishOnly": "npm run build && npm run check"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "svelte": ">=5.20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
